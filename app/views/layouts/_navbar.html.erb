<nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4">
  <%= link_to "VetClinic", root_path, class: "navbar-brand" %>

  <div class="navbar-nav me-auto">
    <% if user_signed_in? %>
      <% if current_user.admin? || current_user.vet? %>
        <%= link_to "Owners", owners_path, class: "nav-link" %>
      <% elsif current_user.owner? %>
        <%= link_to "My Account", owner_path(current_user.owner), class: "nav-link" if current_user.owner %>
      <% end %>
      <%= link_to "Pets", pets_path, class: "nav-link" %>
      <%= link_to "Vets", vets_path, class: "nav-link" %>
      <%= link_to "Appointments", appointments_path, class: "nav-link" %>
    <% end %>
  </div>

  <div class="navbar-nav ms-auto">
    <% if user_signed_in? %>
      <span class="nav-link text-white"><%= current_user.full_name %></span>
      <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-outline-light btn-sm ms-2" %>
    <% else %>
      <%= link_to "Sign in", new_user_session_path, class: "nav-link" %>
    <% end %>
  </div>
</nav>